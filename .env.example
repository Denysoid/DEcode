# Copy this template outside the workspace. It is never loaded implicitly:
#   decode --env-file D:/secrets/decode.env --workspace D:/project
#
# Uncomment only a variable accepted by the selected provider. Do not keep
# unrelated credentials in the same file and never commit the populated copy.

# AZURE_OPENAI_API_KEY=replace_with_your_key
# OPENAI_API_KEY=replace_with_your_key
# GEMINI_API_KEY=replace_with_your_key
# GOOGLE_API_KEY=replace_with_your_key
# ANTHROPIC_API_KEY=replace_with_your_key
# AWS_BEARER_TOKEN_BEDROCK=replace_with_your_key
# OPENROUTER_API_KEY=replace_with_your_key
# XAI_API_KEY=replace_with_your_key
# GROQ_API_KEY=replace_with_your_key
# MISTRAL_API_KEY=replace_with_your_key
# DEEPSEEK_API_KEY=replace_with_your_key
# TOGETHER_API_KEY=replace_with_your_key
# FIREWORKS_API_KEY=replace_with_your_key
# CEREBRAS_API_KEY=replace_with_your_key
# PERPLEXITY_API_KEY=replace_with_your_key
# NVIDIA_API_KEY=replace_with_your_key
# SAMBANOVA_API_KEY=replace_with_your_key
# MOONSHOT_API_KEY=replace_with_your_key
# DASHSCOPE_API_KEY=replace_with_your_key
# HF_TOKEN=replace_with_your_key
# GITHUB_TOKEN=replace_with_your_key
# OLLAMA_API_KEY=replace_with_your_optional_key
# DECODE_PROVIDER_API_KEY=replace_with_your_compatible_provider_key

# Bedrock Runtime uses the standard AWS SDK credential chain instead of a
# DEcode API-key field. Configure AWS_PROFILE/AWS_REGION in the process or with
# normal AWS tooling; see docs/CONFIGURATION.md.
